# One line-ending on disk and in history, on every platform. Node, npm and
# Chrome are all fine with LF on Windows; CRLF churn in diffs is not fine.
* text=auto eol=lf

# What `npm run pack` (git archive) must NOT put in the store zip: the
# listing's own images and copy, the plan, the research, the agent's own
# package, and the repo's furniture. The upload is the extension — the
# manifest at the root, extension/, lib/, skills/ — and nothing else.
store/          export-ignore
bin/            export-ignore
research/       export-ignore
agent/          export-ignore
docs/           export-ignore
.github/        export-ignore
.claude/        export-ignore
integrations/   export-ignore
PLAN.md         export-ignore
CONTRIBUTING.md export-ignore
package-lock.json export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
